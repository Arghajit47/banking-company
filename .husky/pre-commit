branch_name=$(git symbolic-ref --short HEAD)
commit_msg_file="$1"

if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
  # When testing manually without an actual commit message file, skip commit-message validation
  # but still validate the branch name.
  commit_msg=""
else
  commit_msg=$(head -n 1 "$commit_msg_file")
fi

# Branch name must be: Fix/<JIRA_KEY>/<Component_name> or Automation/<JIRA_KEY>/<Component_name>
branch_regex='^(Fix|Automation)/[A-Z]+-[0-9]+/.+$'

if ! echo "$branch_name" | grep -Eq "$branch_regex"; then
  echo "❌ Invalid branch name: '$branch_name'"
  echo "Branch name must follow one of these templates:"
  echo "  Fix/<JIRA_KEY>/<Component_name>"
  echo "  Automation/<JIRA_KEY>/<Component_name>"
  echo "Example: Fix/BC-64/Initial-Project-Setup"
  exit 1
fi

# Extract JIRA key from branch name
jira_key=$(echo "$branch_name" | grep -oE '[A-Z]+-[0-9]+')

# Commit message must start with "<JIRA_KEY> " followed by a lowercase summarized message
commit_regex="^${jira_key} [a-z0-9].*$"

if [ -n "$commit_msg" ] && ! echo "$commit_msg" | grep -Eq "$commit_regex"; then
  echo "❌ Invalid commit message: '$commit_msg'"
  echo "Commit message must follow the strict template:"
  echo "  <JIRA_KEY> <lowercase summarized message>"
  echo "Example: ${jira_key} initial project Setup"
  echo "Rules:"
  echo "  - Must start with the JIRA key extracted from the branch name"
  echo "  - Single line, no period at the end"
  echo "  - Message body starts with a lowercase letter"
  exit 1
fi

npx lint-staged
