# Local development environment variables — copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Database
# DEV: SQLite file path (relative to project root)
# PROD: PostgreSQL connection string from Netlify
DATABASE_URL="file:./prisma/dev.db"

# Public app environment marker
NEXT_PUBLIC_APP_ENV=development

# Optional: public API base path
NEXT_PUBLIC_API_BASE=/api
